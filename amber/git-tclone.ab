import { starts_with, join } from "std/text"
import * from "const.ab"

main(args) {

    if len(args) < 2:
        err("Usage: git tclone <repository-name>")

    // tclone should only take the repository name, not the full URL.
    // Check if the provided argument looks like a full URL
    if starts_with(args[1], "https://") or starts_with(args[1], "git@"):
        err(join([
            "Please provide only the repository name, not the full URL.",
            "Example: git tclone Organization/Repository.git"
        ], "\n"))

    const username = username() failed:
        err("Could not read username.")

    const password = password() failed:
        err("Could not read password.")

    const login_key = trust $ echo -n "{username}:{password}" | base64 $
    $ git -c "{git_auth(login_key)}" clone {gitea_url()}/{args[1]} $ succeeded:
        exit 0
}
